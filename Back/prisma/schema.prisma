//npx prisma migrate dev --name cambio
//Aqui se generan las tablas o models, para la base de datos
//TODO npx prisma studio esto es para ver la base de datos 
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MOD //Solo puede ver y aceptar escenarios
  ADMIN   //Administra toda la pagina, con CRUD
  TEACHER //Solicita el escenario al admin
}


model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  dependence  String
  role        Role     @default(TEACHER)
  createdAt   DateTime @default(now())
}

//Modelo de los eventos a guardar
model Events {
  id          Int      @id @default(autoincrement())
  name        String 
  date        String
  time        String
  description String

  state       String   // ← sede o escenario
  status      String   @default("pendiente") // ← aprobado/rechazado/pendiente

  type        String
  dependence  String?
  createdAt   DateTime @default(now())
}
